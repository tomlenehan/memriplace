# Application
PROJECT_NAME=MemriPlace
DOMAIN=localhost
ENVIRONMENT=local
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Local auth/bootstrap values
SECRET_KEY=local-secret-key-change-me
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=local-admin-password
USERS_OPEN_REGISTRATION=true

# Local Docker Postgres
# Managed Postgres providers such as Render can set DATABASE_URL instead.
DATABASE_URL=
POSTGRES_DB=memribox
POSTGRES_USER=memribox
POSTGRES_PASSWORD=memribox-password
# Published local ports
FRONTEND_PORT=5173

# Frontend API configuration
# Leave VITE_API_URL empty to use same-origin /api calls through Vite/Nginx.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_BACKEND_PROXY_TARGET=http://backend

# Memberships remain dormant until checkout and launch policy are ready.
MEMBERSHIPS_ENABLED=false

# Optional email settings
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587

# Optional integrations
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_UPLOAD_BUCKET_NAME=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
GOOGLE_CLIENT_ID=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_NARRATION_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# LangSmith tracing is opt-in. Traces can include private memory content.
# Preferred names for new configuration:

LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=memriplace-local
# Existing deployments can continue using LANGCHAIN_API_KEY,
# LANGCHAIN_TRACING_V2, LANGCHAIN_ENDPOINT, and LANGCHAIN_PROJECT.

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=memriplace-production

PINECONE_API_KEY=
PINECONE_ENV=
SENTRY_DSN=
